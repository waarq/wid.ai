# Copy to .env.local and adjust. .env files must live in the project root (not src/).
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at build time.
# Never put secrets, API keys or credentials in a NEXT_PUBLIC_* variable.

# Base URL for the WID backend REST API (used by lib/api/apiClient).
# Relative paths are resolved against the app origin.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public URL of this app (canonical URLs, OpenGraph, share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Service implementation switch (services/modes.ts, services/registry.ts).
# true (or unset) = mock services with demo data; false = real API services.
NEXT_PUBLIC_USE_MOCKS=true

# Per-service API mode: comma list of registry keys (or "*") that use the real
# Api* services while the rest keep the NEXT_PUBLIC_USE_MOCKS default.
# Example for real Google sign-in against the backend with mock data elsewhere:
#   NEXT_PUBLIC_API_SERVICES=auth
# Full list of services with an Api* implementation today:
#   NEXT_PUBLIC_API_SERVICES=auth,user,onboarding,settings,integrations,calendar
# A listed service with no Api* implementation yet throws service_unavailable.
NEXT_PUBLIC_API_SERVICES=

# "production" forbids mixed mode: a partial NEXT_PUBLIC_API_SERVICES list is
# ignored and every service follows NEXT_PUBLIC_USE_MOCKS. Use development /
# staging elsewhere.
NEXT_PUBLIC_APP_ENV=development

# Supabase Auth (required when the auth service is in API mode).
# Project Settings > API. The anon (publishable) key is public by design: it
# only grants what Row Level Security allows. NEVER put the service-role key
# in this app, in any NEXT_PUBLIC_* variable or anywhere in the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
